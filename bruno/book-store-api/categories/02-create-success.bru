meta {
  name: Create category success
  type: http
  seq: 2
}
post {
  url: {{baseUrl}}/api/categories
  body: json
  auth: none
}
headers {
  content-type: application/json
}
script:pre-request {
  bru.setVar("runId", Date.now().toString());
}
body:json {
  { "category": { "name": "นิยายไทยทดสอบ {{runId}}" } }
}
script:post-response {
  bru.setVar("createdCategoryId", res.body.category.id);
}
tests {
  test("creates category", function() { expect(res.getStatus()).to.equal(201); });
}
