meta {
  name: List categories success
  type: http
  seq: 1
}
get {
  url: {{baseUrl}}/api/categories
  body: none
  auth: none
}
script:post-response {
  const category = res.body.categories.find((item) => item.name === "การเงิน");
  if (category) bru.setVar("categoryId", category.id);
}
tests {
  test("returns categories", function() { expect(res.getStatus()).to.equal(200); });
}
