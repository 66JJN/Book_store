meta {
  name: Admin login success
  type: http
  seq: 1
}
post {
  url: {{baseUrl}}/api/session
  body: json
  auth: none
}
headers {
  content-type: application/json
}
body:json {
  { "email_address": "{{adminEmail}}", "password": "{{password}}" }
}
tests {
  test("returns admin", function() { expect(res.getStatus()).to.equal(200); expect(res.body.user.role).to.equal("admin"); });
}
