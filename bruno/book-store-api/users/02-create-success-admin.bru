meta {
  name: Create user success admin
  type: http
  seq: 2
}
post {
  url: {{baseUrl}}/api/users
  body: json
  auth: none
}
headers {
  content-type: application/json
}
script:pre-request {
  bru.setVar("runId", Date.now().toString());
}
body:json {
  { "user": { "email_address": "thai.reader.{{runId}}@example.test", "password": "{{newUserPassword}}", "password_confirmation": "{{newUserPassword}}", "role": "user" } }
}
script:post-response {
  if (res.getStatus() === 201) bru.setVar("createdUserId", res.body.user.id);
}
tests {
  test("creates user", function() { expect(res.getStatus()).to.equal(201); });
}
