meta {
  name: Create book success
  type: http
  seq: 3
}
post {
  url: {{baseUrl}}/api/books
  body: json
  auth: none
}
headers {
  content-type: application/json
}
script:pre-request {
  bru.setVar("runId", Date.now().toString());
}
body:json {
  { "book": { "title": "หุ้นมือใหม่ {{runId}}", "author": "พี่ดิว", "isbn": "978000{{runId}}", "description": "หนังสือทดสอบ API หมวดการเงิน", "price": 299.00, "stock": 5, "category_id": {{categoryId}}, "market_ids": [{{marketId}}] } }
}
script:post-response {
  bru.setVar("createdBookId", res.body.book.id);
}
tests {
  test("creates book", function() { expect(res.getStatus()).to.equal(201); });
}
