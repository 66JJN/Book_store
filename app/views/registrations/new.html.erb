<% content_for :title, "Create account" %>

<h1>Create account</h1>
<% if @user.errors.any? %>
  <ul>
    <% @user.errors.full_messages.each do |message| %>
      <li><%= message %></li>
    <% end %>
  </ul>
<% end %>

<%= form_with model: @user, url: registration_path do |form| %>
  <p><%= form.label :email_address, "Email" %><%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "email" %></p>
  <p><%= form.label :password %><%= form.password_field :password, required: true, autocomplete: "new-password" %></p>
  <p><%= form.label :password_confirmation %><%= form.password_field :password_confirmation, required: true, autocomplete: "new-password" %></p>
  <%= form.submit "Create account" %>
<% end %>
