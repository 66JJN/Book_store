<% content_for :title, "Create account" %>

<div class="mx-auto max-w-md rounded border border-red-200 bg-white p-6 shadow-sm">
<h1 class="mb-5 text-2xl font-bold text-red-700">Create account</h1>
<% if @user.errors.any? %>
  <ul class="mb-4 list-inside list-disc rounded bg-red-100 p-3 text-red-700">
    <% @user.errors.full_messages.each do |message| %>
      <li><%= message %></li>
    <% end %>
  </ul>
<% end %>

<%= form_with model: @user, url: registration_path, class: "space-y-4" do |form| %>
  <p><%= form.label :email_address, "Email", class: "font-bold" %><br><%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "email", class: "mt-1 w-full rounded border border-gray-300 px-3 py-2" %></p>
  <p><%= form.label :password, class: "font-bold" %><br><%= form.password_field :password, required: true, autocomplete: "new-password", class: "mt-1 w-full rounded border border-gray-300 px-3 py-2" %></p>
  <p><%= form.label :password_confirmation, class: "font-bold" %><br><%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", class: "mt-1 w-full rounded border border-gray-300 px-3 py-2" %></p>
  <%= form.submit "Create account", class: "cursor-pointer rounded bg-red-600 px-4 py-2 font-bold text-white hover:bg-red-700" %>
<% end %>
</div>
