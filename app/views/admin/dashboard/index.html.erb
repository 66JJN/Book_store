<% content_for :title, "Admin" %>

<h1 class="mb-4 text-3xl font-bold text-red-700">Admin dashboard</h1>
<div class="mb-5 rounded border border-red-200 bg-white p-4 shadow-sm">
  <p><%= pluralize(@book_count, "book") %> in <%= pluralize(@category_count, "category") %>.</p>
  <p><%= pluralize(@market_count, "market") %> and <%= pluralize(@user_count, "user") %>.</p>
</div>
<div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
  <%= link_to "Manage books", admin_books_path, class: "rounded bg-red-600 p-4 text-center font-bold text-white hover:bg-red-700" %>
  <%= link_to "Manage categories", admin_categories_path, class: "rounded bg-red-600 p-4 text-center font-bold text-white hover:bg-red-700" %>
  <%= link_to "Manage markets", admin_markets_path, class: "rounded bg-red-600 p-4 text-center font-bold text-white hover:bg-red-700" %>
  <%= link_to "Manage users", admin_users_path, class: "rounded bg-red-600 p-4 text-center font-bold text-white hover:bg-red-700" %>
</div>
