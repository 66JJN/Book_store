<h1 class="mb-4 text-3xl font-bold text-red-700">Manage Markets</h1>
<p class="mb-4"><%= link_to "Add market", new_admin_market_path, class: "rounded bg-red-600 px-4 py-2 font-bold text-white hover:bg-red-700" %></p>
<div class="overflow-x-auto rounded border border-red-200 bg-white shadow-sm"><table class="w-full text-left">
  <thead class="bg-red-700 text-white"><tr><th class="p-3">Name</th><th class="p-3">Books</th><th class="p-3">Actions</th></tr></thead>
  <tbody>
    <% @markets.each do |market| %>
      <tr class="border-t border-gray-200">
        <td class="p-3 font-bold"><%= market.name %></td>
        <td class="p-3"><%= market.books.size %></td>
        <td class="flex gap-2 p-3"><%= link_to "Edit", edit_admin_market_path(market), class: "rounded border border-red-600 px-2 py-1 text-red-700" %> <%= button_to "Delete", admin_market_path(market), method: :delete, data: { turbo_confirm: "Delete #{market.name}?" }, class: "rounded bg-red-600 px-2 py-1 text-white" %></td>
      </tr>
    <% end %>
  </tbody>
</table></div>
<p class="mt-4"><%= link_to "Back to admin", admin_root_path, class: "text-red-700 underline" %></p>
