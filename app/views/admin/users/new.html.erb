<h1 class="mb-4 text-3xl font-bold text-red-700">Add User</h1>
<% if @user.errors.any? %><ul class="mb-4 list-inside list-disc rounded bg-red-100 p-3 text-red-700"><% @user.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul><% end %>
<%= render "form", user: @user, submit_text: "Create user", password_required: true %>
<p><%= link_to "Back", admin_users_path, class: "mt-4 inline-block text-red-700 underline" %></p>
