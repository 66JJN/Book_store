<%# Copied from activeadmin 4.0.0.beta23 (app/views/active_admin/_html_head.html.erb). Only change: default to light mode. Re-check when upgrading ActiveAdmin. %>
<%= stylesheet_link_tag "active_admin" %>
<meta name="viewport" content="width=device-width,initial-scale=1">
<%= csrf_meta_tags %>
<%= csp_meta_tag %>
<% # On page load or when changing themes, best to add inline in `head` to avoid FOUC %>
<%= javascript_tag nonce: true do %>
  // Book Store: start in light mode (white + red) instead of following the system setting.
  // The moon/sun button still switches to dark mode and remembers the choice.
  if (!('theme' in localStorage)) { localStorage.setItem('theme', 'light') }
  if (localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
    document.documentElement.classList.add('dark')
  } else {
    document.documentElement.classList.remove('dark')
  }
<% end %>
<%= javascript_importmap_tags "active_admin", importmap: ActiveAdmin.importmap %>
