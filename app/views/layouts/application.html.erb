<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Book Store" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Book Store">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body class="min-h-screen bg-red-50 text-gray-800">
    <nav class="flex flex-wrap items-center gap-3 bg-red-700 px-5 py-4 text-white shadow">
      <%= link_to "Book Store", root_path, class: "mr-3 text-xl font-bold" %>
      <% if authenticated? %>
        <%= link_to "Books", books_path, class: "rounded bg-red-600 px-3 py-1 hover:bg-red-800" %>
        <%= link_to "Admin", admin_root_path, class: "rounded bg-red-600 px-3 py-1 hover:bg-red-800" if admin? %>
        <span class="ml-auto text-sm"><%= current_user.email_address %></span>
        <%= button_to "Log out", session_path, method: :delete, class: "rounded border border-white px-3 py-1 text-sm hover:bg-red-800" %>
      <% else %>
        <%= link_to "Sign in", new_session_path, class: "ml-auto rounded bg-white px-3 py-1 text-red-700 hover:bg-red-100" %>
        <%= link_to "Create account", new_registration_path, class: "rounded border border-white px-3 py-1 hover:bg-red-800" %>
      <% end %>
    </nav>

    <% flash.each do |type, message| %>
      <div role="alert" class="mx-auto mt-4 max-w-5xl rounded border border-red-300 bg-white px-4 py-3 text-red-700"><%= message %></div>
    <% end %>

    <main class="mx-auto max-w-5xl px-4 py-8"><%= yield %></main>
  </body>
</html>
