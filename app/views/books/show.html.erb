<% content_for :title, @book.title %>

<article class="rounded border border-red-200 bg-white p-6 shadow-sm">
  <% if @book.cover_image_url.present? %>
    <%= image_tag @book.cover_image_url, alt: "Cover of #{@book.title}", class: "mb-5 max-h-80 rounded object-cover" %>
  <% end %>
  <h1 class="text-3xl font-bold text-red-700"><%= @book.title %></h1>
  <p class="mb-4 text-lg text-gray-600">By <%= @book.author %></p>
  <p>Category: <%= @book.category.name %></p>
  <p>ISBN: <%= @book.isbn %></p>
  <p>Published: <%= @book.published_on || "Not specified" %></p>
  <p class="font-bold text-red-600">Price: <%= number_to_currency(@book.price) %></p>
  <p>In stock: <%= @book.stock %></p>
  <div class="mt-4 border-t pt-4"><%= simple_format(@book.description) %></div>
</article>

<%= link_to "Back to books", books_path, class: "mt-5 inline-block rounded bg-red-600 px-4 py-2 font-bold text-white hover:bg-red-700" %>
