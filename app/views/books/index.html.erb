<% content_for :title, "Books" %>

<h1 class="mb-6 text-center text-3xl font-bold text-red-700">
  All Books
</h1>

<%= form_with url: books_path, method: :get, class: "mb-6 flex flex-wrap items-center justify-center gap-2 rounded border border-red-200 bg-white p-4 shadow-sm" do |form| %>
  <%= form.label :q, "Search books", class: "font-bold text-red-700" %>
  <%= form.search_field :q, value: @query, placeholder: "Title, author, or ISBN", class: "rounded border border-gray-300 px-3 py-2" %>
  <%= form.hidden_field :category_id, value: @selected_category_id %>
  <%= form.submit "Search", class: "cursor-pointer rounded bg-red-600 px-4 py-2 font-bold text-white hover:bg-red-700" %>
  <%= link_to "Clear", books_path, class: "rounded border border-red-600 px-4 py-2 text-red-700" if @query.present? || @selected_category_id.present? %>
<% end %>

<section aria-label="Book categories" class="mb-6 rounded border border-red-200 bg-white p-4 shadow-sm">
  <h2 class="mb-3 text-xl font-bold text-red-700">Categories</h2>
  <%= link_to "All", books_path(q: @query), class: "mr-2 inline-block rounded bg-red-600 px-3 py-1 text-white" %>
  <% @categories.each do |category| %>
    <%= link_to category.name, books_path(category_id: category.id, q: @query), class: "mb-2 mr-2 inline-block rounded border border-red-400 px-3 py-1 text-red-700 hover:bg-red-100" %>
  <% end %>
</section>

<p class="mb-4 font-bold text-red-700"><%= pluralize(@books.count, "book") %> found.</p>

<% if @books.any? %>
  <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3">
    <% @books.each do |book| %>
      <li class="rounded border border-red-200 bg-white p-4 shadow-sm">
        <% if book.cover_image_url.present? %>
          <%= image_tag book.cover_image_url, alt: "Cover of #{book.title}", class: "mb-3 h-40 w-full rounded object-cover" %>
        <% end %>
        <h2 class="text-lg font-bold text-red-700"><%= link_to book.title, book_path(book) %></h2>
        <p class="text-gray-600"><%= book.author %></p>
        <p class="mt-2 text-sm"><%= book.category.name %></p>
        <p class="mt-2 font-bold text-red-600"><%= number_to_currency(book.price) %></p>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="rounded bg-white p-4 text-center">No books match your search.</p>
<% end %>
