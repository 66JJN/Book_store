<% content_for :title, "Sign in" %>

<div class="mx-auto max-w-md rounded border border-red-200 bg-white p-6 shadow-sm">
<h1 class="mb-5 text-2xl font-bold text-red-700">Sign in</h1>
<%= form_with url: session_path, class: "space-y-4" do |form| %>
  <p>
    <%= form.label :email_address, "Email", class: "font-bold" %><br>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "email", class: "mt-1 w-full rounded border border-gray-300 px-3 py-2" %>
  </p>
  <p>
    <%= form.label :password, class: "font-bold" %><br>
    <%= form.password_field :password, required: true, autocomplete: "current-password", class: "mt-1 w-full rounded border border-gray-300 px-3 py-2" %>
  </p>
  <%= form.submit "Sign in", class: "cursor-pointer rounded bg-red-600 px-4 py-2 font-bold text-white hover:bg-red-700" %>
<% end %>

<p><%= link_to "Create an account", new_registration_path, class: "text-red-700 underline" %></p>
</div>
