<% content_for :title, "Forgot your password?" %>

<div class="mx-auto max-w-md rounded border border-red-200 bg-white p-6 shadow-sm">
  <h1 class="mb-5 text-2xl font-bold text-red-700">Forgot your password?</h1>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "space-y-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <p>
      <%= f.label :email, class: "font-bold" %><br>
      <%= f.email_field :email, required: true, autofocus: true, autocomplete: "email", class: "mt-1 w-full rounded border border-gray-300 px-3 py-2" %>
    </p>
    <%= f.submit "Send reset instructions", class: "cursor-pointer rounded bg-red-600 px-4 py-2 font-bold text-white hover:bg-red-700" %>
  <% end %>

  <%= render "devise/shared/links" %>
</div>
