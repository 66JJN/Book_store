<% content_for :title, "Sign in" %>

<div class="mx-auto max-w-md rounded border border-red-200 bg-white p-6 shadow-sm">
  <h1 class="mb-5 text-2xl font-bold text-red-700">Sign in</h1>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4" }) do |f| %>
    <p>
      <%= f.label :email, class: "font-bold" %><br>
      <%= f.email_field :email, required: true, autofocus: true, autocomplete: "email", class: "mt-1 w-full rounded border border-gray-300 px-3 py-2" %>
    </p>
    <p>
      <%= f.label :password, class: "font-bold" %><br>
      <%= f.password_field :password, required: true, autocomplete: "current-password", class: "mt-1 w-full rounded border border-gray-300 px-3 py-2" %>
    </p>
    <% if devise_mapping.rememberable? %>
      <p class="flex items-center gap-2">
        <%= f.check_box :remember_me, class: "accent-red-600" %>
        <%= f.label :remember_me %>
      </p>
    <% end %>
    <%= f.submit "Sign in", class: "cursor-pointer rounded bg-red-600 px-4 py-2 font-bold text-white hover:bg-red-700" %>
  <% end %>

  <%= render "devise/shared/links" %>
</div>
