<div class="mt-5 space-y-1 border-t border-red-100 pt-4 text-sm text-red-700">
  <%- if controller_name != "sessions" %>
    <p><%= link_to "Sign in", new_session_path(resource_name), class: "hover:underline" %></p>
  <% end %>

  <%- if devise_mapping.registerable? && controller_name != "registrations" %>
    <p><%= link_to "Sign up", new_registration_path(resource_name), class: "hover:underline" %></p>
  <% end %>

  <%- if devise_mapping.recoverable? && controller_name != "passwords" && controller_name != "registrations" %>
    <p><%= link_to "Forgot your password?", new_password_path(resource_name), class: "hover:underline" %></p>
  <% end %>
</div>
