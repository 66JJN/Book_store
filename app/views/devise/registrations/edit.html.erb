<% content_for :title, "My account" %>

<div class="mx-auto max-w-md rounded border border-red-200 bg-white p-6 shadow-sm">
  <h1 class="mb-5 text-2xl font-bold text-red-700">My account</h1>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "space-y-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <p>
      <%= f.label :email, class: "font-bold" %><br>
      <%= f.email_field :email, required: true, autocomplete: "email", class: "mt-1 w-full rounded border border-gray-300 px-3 py-2" %>
    </p>
    <p>
      <%= f.label :password, "New password", class: "font-bold" %>
      <span class="text-sm text-gray-500">(leave blank to keep the current one)</span><br>
      <%= f.password_field :password, autocomplete: "new-password", class: "mt-1 w-full rounded border border-gray-300 px-3 py-2" %>
    </p>
    <p>
      <%= f.label :password_confirmation, "Confirm new password", class: "font-bold" %><br>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "mt-1 w-full rounded border border-gray-300 px-3 py-2" %>
    </p>
    <p>
      <%= f.label :current_password, class: "font-bold" %>
      <span class="text-sm text-gray-500">(needed to save any change)</span><br>
      <%= f.password_field :current_password, required: true, autocomplete: "current-password", class: "mt-1 w-full rounded border border-gray-300 px-3 py-2" %>
    </p>
    <%= f.submit "Update", class: "cursor-pointer rounded bg-red-600 px-4 py-2 font-bold text-white hover:bg-red-700" %>
  <% end %>

  <%# Admins cannot delete themselves (also enforced in Users::RegistrationsController) %>
  <% unless resource.admin? %>
    <div class="mt-6 border-t border-red-100 pt-4">
      <h2 class="font-bold text-red-700">Delete my account</h2>
      <%= button_to "Delete my account", registration_path(resource_name), method: :delete,
            form: { data: { turbo_confirm: "Delete your account? This cannot be undone." } },
            class: "mt-2 cursor-pointer rounded border border-red-600 px-4 py-2 text-sm text-red-700 hover:bg-red-50" %>
    </div>
  <% end %>
</div>
