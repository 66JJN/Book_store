<% content_for :title, "Sign up" %>

<div class="mx-auto max-w-md rounded border border-red-200 bg-white p-6 shadow-sm">
  <h1 class="mb-5 text-2xl font-bold text-red-700">Sign up</h1>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <p>
      <%= f.label :email, class: "font-bold" %><br>
      <%= f.email_field :email, required: true, autofocus: true, autocomplete: "email", class: "mt-1 w-full rounded border border-gray-300 px-3 py-2" %>
    </p>
    <p>
      <%= f.label :password, class: "font-bold" %>
      <% if @minimum_password_length %>
        <span class="text-sm text-gray-500">(<%= @minimum_password_length %> characters minimum)</span>
      <% end %><br>
      <%= f.password_field :password, required: true, autocomplete: "new-password", class: "mt-1 w-full rounded border border-gray-300 px-3 py-2" %>
    </p>
    <p>
      <%= f.label :password_confirmation, class: "font-bold" %><br>
      <%= f.password_field :password_confirmation, required: true, autocomplete: "new-password", class: "mt-1 w-full rounded border border-gray-300 px-3 py-2" %>
    </p>
    <%= f.submit "Sign up", class: "cursor-pointer rounded bg-red-600 px-4 py-2 font-bold text-white hover:bg-red-700" %>
  <% end %>

  <%= render "devise/shared/links" %>
</div>
